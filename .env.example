# Local Admin API key. Do not commit the real value.
SAMCO_ADMIN_KEY=change-me

# Allow the local Next.js app to write data/control/admin_overrides.json.
# Keep false on Vercel; production admin persistence should use Supabase.
SAMCO_ALLOW_LOCAL_FILE_WRITES=true

# Optional Vercel deploy hook. create_json.bat / Clean.bat will call it after GitHub push.
VERCEL_DEPLOY_HOOK_URL=

# Optional production services
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Event-driven core (optional but recommended in production)
DATABASE_URL=
DB_SSL=true
DB_POOL_MAX=8
REDIS_URL=
SAMCO_EVENT_STREAM=samco:events
SAMCO_EVENT_GROUP=samco-workers
SAMCO_EVENT_CONSUMER=local-worker

# Integration Gateway - all optional, none required for core operation
GITHUB_REPOSITORY=https://github.com/ahmedlabib33-boop/CTO-Standards-Workspace.git
PRIMAVERA_API_URL=
SAP_API_URL=
MICROSOFT365_API_URL=
POWERBI_API_URL=

# Project document intake engine.
# Local: run `uvicorn ingestion.service:app --reload --port 8010` and set the public URL below.
NEXT_PUBLIC_INGESTION_API_URL=http://127.0.0.1:8010/api/intake
SAMCO_INGESTION_API_URL=http://127.0.0.1:8010/api/intake
SAMCO_INGESTION_MAX_BYTES=50000000
SAMCO_INGESTION_MAX_FILES=40
